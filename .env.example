# ─────────────────────────────────────────────
#  Production / Remote MySQL Server (direct)
# ─────────────────────────────────────────────
# Use the read-only account from sql/create_sync_readonly_user.sql
PROD_DB_HOST=10.10.0.1
PROD_DB_PORT=3306
PROD_DB_USER=erp_sync_ro
# Wrap in double quotes if password contains special chars: & $ ' [ ] ! %
# Escape $ with \$  (e.g. PROD_DB_PASS="my\$ecret&pass")
PROD_DB_PASS=your_production_password

# ─────────────────────────────────────────────
#  Local MySQL (Docker)
# ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_LOCAL_PORT=3306
# InnoDB buffer pool — ~50-70% of server RAM. Bigger = faster restores.
MYSQL_BUFFER_POOL=2G

# ─────────────────────────────────────────────
#  MySQL Users – JSON array (created locally)
#  { "user":"", "password":"", "host":"", "privileges":"" }
# ─────────────────────────────────────────────
MYSQL_USERS_JSON='[
  {"user":"app_user",  "password":"AppP@ssw0rd!",  "host":"%",        "privileges":"ALL PRIVILEGES"},
  {"user":"readonly",  "password":"R3adOnly#2024",  "host":"localhost", "privileges":"SELECT"}
]'

# ─────────────────────────────────────────────
#  Sync Schedule
#  SYNC_INTERVAL_HOURS : 2 or 3
#  SYNC_CRON_OVERRIDE  : custom cron expression (overrides interval)
# ─────────────────────────────────────────────
#  Incremental syncs are fast, so you can run them often, e.g.:
#  SYNC_CRON_OVERRIDE="*/30 * * * *"     ← quotes required
#  (Overlapping runs are impossible — sync.sh holds a lock.)
# ─────────────────────────────────────────────
SYNC_INTERVAL_HOURS=2
SYNC_CRON_OVERRIDE=

# ─────────────────────────────────────────────
#  Sync Engine
#  SYNC_MODE          : incremental (copy only changed tables) | full
#  SYNC_CHANGE_DETECT : stats    – compare information_schema metadata (instant)
#                       checksum – CHECKSUM TABLE on prod (exact, reads every row)
#  SYNC_PARALLEL      : tables copied at once (keep ≤ MAX_USER_CONNECTIONS - 2)
#  FULL_SYNC_HOUR     : first run at/after this hour each day is a FULL sync
#                       (safety net for stats mode). Empty = never automatic.
#  SYNC_EXCLUDE_DBS   : regex of databases to skip       e.g. 'test_.*|old_erp'
#  SYNC_EXCLUDE_TABLES: regex of db.table to skip        e.g. 'erp\.audit_log|.*\.tmp_.*'
#  SYNC_DROP_MISSING  : 1 = drop local tables deleted on prod
#  SYNC_DROP_MAX      : safety cap — skip drops if more than N would be dropped
#  FAST_RESTORE_DISABLE_REDO : 1 = disable InnoDB redo log during big loads
#                       (2-3x faster; a power cut mid-sync means re-creating
#                        the local volume + full sync — only for a pure mirror)
#  MYSQLDUMP_EXTRA_OPTS: extra mysqldump flags, e.g. --compress for a WAN link
# ─────────────────────────────────────────────
SYNC_MODE=incremental
SYNC_CHANGE_DETECT=stats
SYNC_PARALLEL=4
FULL_SYNC_HOUR=2
SYNC_EXCLUDE_DBS=
SYNC_EXCLUDE_TABLES=
SYNC_DROP_MISSING=1
SYNC_DROP_MAX=100
FAST_RESTORE_DISABLE_REDO=0
MYSQLDUMP_EXTRA_OPTS=

# ─────────────────────────────────────────────
#  Paths
# ─────────────────────────────────────────────
BACKUP_DIR=/tmp/erp_backups
LOG_DIR=/var/log/erp_sync
# Sync state (fingerprints, history) — default: ./state
STATE_DIR=

# ─────────────────────────────────────────────
#  Backup Retention
#  BACKUP_KEEP_DAYS  : delete dumps older than N days
#  BACKUP_KEEP_COUNT : keep at most N most recent sync runs (0 = delete dumps
#                      right after restore — saves disk)
#  LOG_KEEP_COUNT    : keep N most recent sync log files
# ─────────────────────────────────────────────
BACKUP_KEEP_DAYS=1
BACKUP_KEEP_COUNT=3
LOG_KEEP_COUNT=14

# ─────────────────────────────────────────────
#  Web Dashboard (api.py)
#  API_TOKEN : secret token required to log in
#              — change this to something strong!
#  API_PORT  : port the dashboard listens on
# ─────────────────────────────────────────────
API_TOKEN=change_me_strong_token
API_PORT=8080
