[mysqld]
# ── Authentication ────────────────────────────────────────────
default-authentication-plugin       = mysql_native_password
sha256-password-auto-generate-rsa-keys = OFF

# ── Timezone ─────────────────────────────────────────────────
default-time-zone                   = +05:30

# ── SQL Mode (ONLY_FULL_GROUP_BY removed to fix GROUP BY) ─────
sql-mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ── Binary log ───────────────────────────────────────────────
# This is a local mirror — binary logging is not needed and causes
# massive storage growth (gigabytes per sync cycle).
skip-log-bin
log-bin-trust-function-creators     = 1

# ── Events ───────────────────────────────────────────────────
# Production's scheduled events are copied here; running them on the
# mirror would modify mirrored data. The sync keeps data fresh instead.
event-scheduler                     = OFF

# ── InnoDB tuning (reclaim undo log space) ────────────────────
innodb_undo_log_truncate            = ON
innodb_max_undo_log_size            = 256M

# ── Bulk-load speed (mirror: data can always be re-synced) ────
# Buffer pool size is set in docker-compose.yml from MYSQL_BUFFER_POOL (.env)
innodb_flush_log_at_trx_commit      = 2      # flush redo once/sec, not per commit
innodb_doublewrite                  = OFF    # halves write I/O during restores
innodb_flush_method                 = O_DIRECT
innodb_log_buffer_size              = 64M
loose-innodb_redo_log_capacity      = 2G     # MySQL 8.0.30+ (fewer checkpoints)
innodb_io_capacity                  = 2000
innodb_io_capacity_max              = 4000
innodb_write_io_threads             = 8
innodb_autoinc_lock_mode            = 2
max_allowed_packet                  = 1G
max_connections                     = 300

# ── GROUP_CONCAT max length ───────────────────────────────────
group-concat-max-len                = 4294967295

# ── Query timeout (ms) ────────────────────────────────────────
max-execution-time                  = 60000
